rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function adminRecord() {
      return get(/databases/$(database)/documents/adminAccess/$(request.auth.uid));
    }

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isMember(treeId) {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.uid))
        && adminRecord().data.status == 'active'
        && adminRecord().data.treeId == treeId
        && (!adminRecord().data.keys().hasAny(['role'])
          || adminRecord().data.role in ['admin', 'user']);
    }

    function isAdmin(treeId) {
      return isMember(treeId)
        && (!adminRecord().data.keys().hasAny(['role'])
          || adminRecord().data.role == 'admin');
    }

    function validAccessRequestCreate(uid) {
      return request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'treeId', 'email', 'displayName', 'status', 'approvedRole',
          'requestedAt', 'updatedAt', 'reviewedAt', 'reviewedBy'
        ])
        && request.resource.data.treeId is string
        && request.resource.data.treeId.size() > 0
        && request.resource.data.treeId.size() <= 128
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.approvedRole == null
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;
    }

    function validAccessDecision(uid) {
      return resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'treeId', 'email', 'displayName', 'status', 'approvedRole',
          'requestedAt', 'updatedAt', 'reviewedAt', 'reviewedBy'
        ])
        && request.resource.data.treeId == resource.data.treeId
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.requestedAt == resource.data.requestedAt
        && request.resource.data.status in ['approved', 'rejected']
        && (request.resource.data.status == 'approved'
          ? request.resource.data.approvedRole in ['admin', 'user']
          : request.resource.data.approvedRole == null)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && (request.resource.data.status == 'rejected'
          || (existsAfter(/databases/$(database)/documents/adminAccess/$(uid))
            && getAfter(/databases/$(database)/documents/adminAccess/$(uid)).data.treeId == resource.data.treeId
            && getAfter(/databases/$(database)/documents/adminAccess/$(uid)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/adminAccess/$(uid)).data.role == request.resource.data.approvedRole));
    }

    function validAccessGrant(uid) {
      return request.resource.data.keys().hasOnly([
          'treeId', 'status', 'role', 'displayName', 'email',
          'createdAt', 'approvedAt', 'approvedBy'
        ])
        && request.resource.data.treeId is string
        && request.resource.data.status == 'active'
        && request.resource.data.role in ['admin', 'user']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time
        && request.resource.data.approvedAt == request.time
        && request.resource.data.approvedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/accessRequests/$(uid))
        && getAfter(/databases/$(database)/documents/accessRequests/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/accessRequests/$(uid)).data.treeId == request.resource.data.treeId
        && getAfter(/databases/$(database)/documents/accessRequests/$(uid)).data.approvedRole == request.resource.data.role
        && getAfter(/databases/$(database)/documents/accessRequests/$(uid)).data.email == request.resource.data.email;
    }

    function nullableString(value, maximum) {
      return value == null || (value is string && value.size() <= maximum);
    }

    function dateOrNull(value) {
      return value == null || (value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validTree() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'selectedRootFamilyUnitId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 2
        && nullableString(request.resource.data.selectedRootFamilyUnitId, 128)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validPerson() {
      return request.resource.data.keys().hasOnly([
          'name', 'gender', 'dateOfBirth', 'dateOfDeath', 'isAlive',
          'currentPlaceOfResidence', 'version', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.gender in ['male', 'female', 'other', 'unknown']
        && dateOrNull(request.resource.data.dateOfBirth)
        && dateOrNull(request.resource.data.dateOfDeath)
        && request.resource.data.isAlive is bool
        && nullableString(request.resource.data.currentPlaceOfResidence, 160)
        && request.resource.data.version is int
        && request.resource.data.version > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validPrivatePerson() {
      return request.resource.data.keys().hasOnly(['contactNumber', 'updatedAt'])
        && nullableString(request.resource.data.contactNumber, 32)
        && request.resource.data.updatedAt == request.time;
    }

    function validFamilyUnit() {
      return request.resource.data.keys().hasOnly([
          'husbandId', 'wifeId', 'anniversaryDate', 'childrenIds',
          'createdAt', 'updatedAt'
        ])
        && nullableString(request.resource.data.husbandId, 128)
        && nullableString(request.resource.data.wifeId, 128)
        && dateOrNull(request.resource.data.anniversaryDate)
        && request.resource.data.childrenIds is list
        && request.resource.data.childrenIds.size() <= 100
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    match /trees/{treeId} {
      allow read: if isMember(treeId);
      allow create: if isAdmin(treeId) && validTree()
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin(treeId) && validTree()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /people/{personId} {
        allow read: if isMember(treeId);
        allow create: if isAdmin(treeId) && validPerson()
          && request.resource.data.version == 1
          && request.resource.data.createdAt == request.time;
        allow update: if isAdmin(treeId) && validPerson()
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin(treeId);
      }

      match /familyUnits/{unitId} {
        allow read: if isMember(treeId);
        allow create: if isAdmin(treeId) && validFamilyUnit()
          && request.resource.data.createdAt == request.time;
        allow update: if isAdmin(treeId) && validFamilyUnit()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin(treeId);
      }

      match /personPrivate/{personId} {
        allow read: if isAdmin(treeId);
        allow create, update: if isAdmin(treeId) && validPrivatePerson();
        allow delete: if isAdmin(treeId);
      }
    }

    match /adminAccess/{uid} {
      allow get: if isGoogleUser() && request.auth.uid == uid;
      allow list: if resource.data.treeId is string
        && isAdmin(resource.data.treeId);
      allow create: if isAdmin(request.resource.data.treeId)
        && validAccessGrant(uid);
      allow update, delete: if false;
    }

    match /accessRequests/{uid} {
      allow get: if isGoogleUser()
        && (request.auth.uid == uid
          || (resource.data.treeId is string && isAdmin(resource.data.treeId)));
      allow list: if resource.data.treeId is string
        && isAdmin(resource.data.treeId);
      allow create: if isGoogleUser()
        && validAccessRequestCreate(uid);
      allow update: if resource.data.treeId is string
        && isAdmin(resource.data.treeId)
        && validAccessDecision(uid);
      allow delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if resource.data.treeId is string
        && isAdmin(resource.data.treeId);
      allow create: if request.resource.data.keys().hasOnly([
          'treeId', 'actorUid', 'action', 'resourceType', 'resourceId', 'createdAt'
        ])
        && isAdmin(request.resource.data.treeId)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in [
          'person.created', 'person.updated', 'person.deleted',
          'family_unit.created', 'family_unit.updated', 'family_unit.deleted',
          'tree.root_changed', 'tree.import_replaced', 'tree.import_merged',
          'access_request.approved', 'access_request.rejected'
        ]
        && request.resource.data.resourceType in [
          'person', 'familyUnit', 'tree', 'accessRequest'
        ]
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() <= 128
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
