{
  "name": "family-tree-functions",
  "private": true,
  "engines": { "node": "22" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test",
    "test": "npm run build && node --import tsx --test test/domain.test.ts",
    "test:rules": "firebase emulators:exec --project demo-family-tree --only firestore \"npm run test:rules:inner\"",
    "test:rules:inner": "node --import tsx --test test/firestore.rules.test.ts",
    "seed-admin": "node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "7.11.6",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.11.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
